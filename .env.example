# Copy to .env (never commit .env). The backend reads it on startup; restart after changes.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Email of the sandbox Business account (the platform). Payouts to it are blocked.
PAYPAL_PLATFORM_EMAIL=
# Webhook id from the sandbox app's Webhooks section (optional locally; the poller covers it)
PAYPAL_WEBHOOK_ID=
# Where PayPal sends the buyer after approval
APP_BASE_URL=http://localhost:3000

# Postgres (defaults match docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/proofpay
DB_USER=
DB_PASSWORD=

# AI (LangChain4j + OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# low | medium | high for reasoning models (gpt-5*, o*). Leave EMPTY for non-reasoning models like gpt-4.1-mini.
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=120
# Optional: raises the GitHub API limit from 60 to 5000 requests/hour (a fine-grained token with no scopes works)
GITHUB_TOKEN=
