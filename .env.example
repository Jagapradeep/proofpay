# Copy to .env (never commit .env). The backend reads it on startup; restart after changes.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Email of the sandbox Business account (the platform). Payouts to it are blocked.
PAYPAL_PLATFORM_EMAIL=
# Webhook id from the sandbox app's Webhooks section (optional locally; the poller covers it)
PAYPAL_WEBHOOK_ID=
# Where PayPal sends the buyer after approval
APP_BASE_URL=http://localhost:3000

# Postgres (defaults match docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/proofpay
DB_USER=
DB_PASSWORD=

# AI (LangChain4j + OpenAI)
OPENAI_API_KEY=
# gpt-5-mini. Do not use gpt-5-nano for the verifier: in tests it skipped verdicts and passed incomplete work.
OPENAI_MODEL=gpt-5-mini
# minimal | low | medium | high for reasoning models (gpt-5*, o*). Leave EMPTY for non-reasoning models like gpt-4.1-mini.
OPENAI_REASONING_EFFORT=minimal
OPENAI_TIMEOUT_SECONDS=120
# Reuse identical AI answers (saves cost in testing and judging). false = always call the model.
AI_CACHE_ENABLED=true
# AI calls (criteria + verify) allowed per hour, per visitor IP and overall
AI_RATE_LIMIT_PER_IP=20
AI_RATE_LIMIT_GLOBAL=120
# Optional: raises the GitHub API limit from 60 to 5000 requests/hour (a fine-grained token with no scopes works)
GITHUB_TOKEN=
