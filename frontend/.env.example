# Copy to .env.local for local dev (never commit it).
# Where the Spring Boot API runs. The Next.js server calls it; the browser never does.
BACKEND_URL=http://localhost:8080
# Must match PROOFPAY_API_KEY on the backend (leave empty if the backend key is empty).
PROOFPAY_API_KEY=
# Sandbox app client id (public; used by the PayPal button in the browser).
PAYPAL_CLIENT_ID=
# Prefilled in the "Post a job" form so judges can run the demo with sandbox accounts.
DEMO_CLIENT_EMAIL=
DEMO_FREELANCER_EMAIL=
